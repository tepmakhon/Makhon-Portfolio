# EmailJS browser identifiers only. Never add private API keys to VITE_* variables.
VITE_EMAIL_SERVICE_ID=your_service_id
VITE_EMAIL_TEMPLATE_ID=your_template_id
VITE_EMAIL_PUBLIC_KEY=your_public_key

# Optional public ownership-verification tokens (not secret API credentials).
# Paste only each provider's meta-tag content value, then rebuild/redeploy.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
